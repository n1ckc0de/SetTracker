# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gymsync
DB_USER=gymsync
DB_PASSWORD=gymsync

# Server
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# JWT (use a strong secret in production — at least 256 bits)
JWT_SECRET=change-me-in-production-use-at-least-256-bits-of-entropy
JWT_EXPIRATION_MS=3600000

# Webhook HMAC
WEBHOOK_SECRET=change-me-webhook-secret

# CORS (comma-separated origins, no wildcard with credentials)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# AI workout-notes import (Phase 6)
# provider = "rule-based" (default, deterministic, no network/API key needed) or "openai"
# ("openai" also covers any OpenAI-compatible endpoint, e.g. Gemini's compat API)
LLM_PROVIDER=rule-based
# Required only when LLM_PROVIDER=openai
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini

# Progressive overload recommendation engine (Phase 5)
TRAINING_TARGET_REP_MIN=6
TRAINING_TARGET_REP_MAX=12
TRAINING_WEIGHT_INCREMENT=5.00

# Optional YouTube Data API v3 key for exercise media auto-suggestions.
# When unset, generate still returns curated demos + Wikimedia (if reachable).
# YOUTUBE_API_KEY=
